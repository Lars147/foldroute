{
  "name": "foldroute-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run licenses:check && npm run check && vite build",
    "licenses:check": "node scripts/check-licenses.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:parity": "sh scripts/parity.sh",
    "check": "npm run architecture:check && npm run format:check && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.tests.json",
    "architecture:check": "node scripts/check-architecture.mjs",
    "format:check": "prettier --check \"src/components/**/*.svelte\""
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.14.0",
    "motion": "14.3.0",
    "ol": "10.11.0",
    "ol-mapbox-style": "13.8.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  }
}
